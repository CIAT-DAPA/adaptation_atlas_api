# --------------------------------------------------------------------------- #
# Application
# --------------------------------------------------------------------------- #
APP_NAME="Adaptation Atlas API"
APP_VERSION="0.1.0"
APP_ENV=development            # development | staging | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
API_PREFIX=/api/v1
CORS_ORIGINS=*                 # Comma separated list of allowed origins, or *

# --------------------------------------------------------------------------- #
# AWS / S3 storage
# --------------------------------------------------------------------------- #
STORAGE_BACKEND=s3             # s3 | local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=             # Optional, only for temporary credentials
AWS_REGION=us-east-1
S3_BUCKET=digital-atlas
S3_ENDPOINT_URL=               # Optional, for S3 compatible services (MinIO, etc.)
LOCAL_STORAGE_ROOT=            # Root directory when STORAGE_BACKEND=local (tests/dev)

# --------------------------------------------------------------------------- #
# Dataset catalog
# --------------------------------------------------------------------------- #
CATALOG_PATH=catalog           # Directory with one YAML file per published dataset
PARTITION_CACHE_TTL_SECONDS=3600   # How long the discovered partition index is kept

# --------------------------------------------------------------------------- #
# DuckDB query engine
# --------------------------------------------------------------------------- #
DUCKDB_MEMORY_LIMIT=2GB
DUCKDB_THREADS=4
QUERY_TIMEOUT_SECONDS=60
MAX_ROWS_PER_RESPONSE=50000    # Hard cap for a single JSON/CSV response
DEFAULT_PAGE_SIZE=1000
